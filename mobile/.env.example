# Copy to .env and fill in ONE of the two backends below.

# Local development: calls OpenAI directly. The key is inlined into the dev
# bundle — never use this mode for a store build.
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Production / TestFlight: the app talks only to your proxy (see
# proxy/README.md) and no key ships in the binary. When this is set, the
# key above is ignored.
# EXPO_PUBLIC_API_PROXY_URL=https://medlingua-proxy.YOUR-SUBDOMAIN.workers.dev
