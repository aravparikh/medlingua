{"nodes": [{"id": "proxy_readme_cloudflare_worker_proxy", "label": "MedLingua Cloudflare Worker API Proxy", "file_type": "document", "source_file": "proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ~100-line Cloudflare Worker holds the OpenAI key (encrypted secret at Cloudflare, never in the repo) so it never ships inside the app binary; the key can be rotated with wrangler secret put without an app update."}, {"id": "proxy_readme_per_device_rate_limiting", "label": "Per-Device Daily Rate Limiting", "file_type": "concept", "source_file": "proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A random per-install device id is counted in a Cloudflare KV namespace against DAILY_REQUEST_LIMIT (default 300 requests/device/day, roughly 100 conversation turns), enforcing abuse limits without accounts."}, {"id": "proxy_readme_api_proxy_url_env", "label": "EXPO_PUBLIC_API_PROXY_URL Switch", "file_type": "concept", "source_file": "proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When set, the app sends no API key at all, only the random per-install id; when unset (local dev), the app falls back to calling OpenAI directly with EXPO_PUBLIC_OPENAI_API_KEY."}], "edges": [{"source": "proxy_readme_per_device_rate_limiting", "target": "proxy_readme_cloudflare_worker_proxy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "proxy/README.md", "source_location": null, "weight": 1.0}, {"source": "proxy_readme_api_proxy_url_env", "target": "proxy_readme_cloudflare_worker_proxy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "proxy/README.md", "source_location": null, "weight": 1.0}, {"source": "proxy_readme_per_device_rate