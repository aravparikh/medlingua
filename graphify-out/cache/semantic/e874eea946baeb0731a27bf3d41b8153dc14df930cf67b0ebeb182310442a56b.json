{"nodes": [{"id": "_agents_skills_humanizer_skill_humanizer", "label": "Humanizer Skill", "file_type": "document", "source_file": ".agents/skills/humanizer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes signs of AI-generated writing so text sounds natural and human; built because AI prose has specific statistical tells (em dashes, rule of three, AI vocabulary) that cluster and are detectable."}, {"id": "_agents_skills_humanizer_skill_ai_writing_patterns", "label": "Signs of AI Writing Patterns", "file_type": "concept", "source_file": ".agents/skills/humanizer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detection relies on clusters of tells rather than isolated ones, because single patterns (one em dash, curly quotes) produce false positives against legitimate human prose."}, {"id": "_agents_skills_humanizer_skill_voice_calibration", "label": "Voice Calibration from Writing Sample", "file_type": "concept", "source_file": ".agents/skills/humanizer/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing AI patterns is not enough; the rewrite must replace them with patterns from the author's own sample, otherwise sterile voiceless output is itself an AI tell."}, {"id": "_agents_skills_humanizer_skill_wikipedia_signs_of_ai_writing", "label": "Wikipedia: Signs of AI Writing (WikiProject AI Cleanup)", "file_type": "paper", "source_file": ".agents/skills/humanizer/SKILL.md", "source_location": null, "source_url": "https://en.wikipedia.org/wiki/Wikipedia:Signs_of_AI_writing", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_agents_skills_humanizer_skill_humanizer", "target": "_agents_skills_humanizer_skill_wikipedia_signs_of_ai_writing", "relation": "cites", "confidence": "EXTRACTED", "confid