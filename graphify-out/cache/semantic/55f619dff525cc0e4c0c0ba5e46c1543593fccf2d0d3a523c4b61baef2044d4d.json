{"nodes": [{"id": "mobile_readme_medlingua_app", "label": "MedLingua iOS App", "file_type": "document", "source_file": "mobile/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-time two-way medical translation (English vs Spanish/Mandarin/Vietnamese/Russian) built for seniors and limited-English speakers; screen switching in App.tsx deliberately avoids a navigation library."}, {"id": "mobile_readme_translation_pipeline", "label": "Whisper to GPT-4o to TTS Translation Pipeline", "file_type": "concept", "source_file": "mobile/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whisper transcribes, GPT-4o translates for a medical context, OpenAI TTS speaks the result with on-device speech as automatic fallback; implemented in src/services/openai.ts."}, {"id": "mobile_readme_no_storage_privacy", "label": "Nothing-Is-Stored Privacy Design", "file_type": "concept", "source_file": "mobile/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transcripts live only in memory (cleared on language change, gone when the app closes) and the single temporary TTS audio file is overwritten each turn, so no user conversation data persists."}, {"id": "mobile_readme_quick_phrases", "label": "Quick Phrases (pre-translated, offline)", "file_type": "concept", "source_file": "mobile/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-translated clinician questions and patient responses speak instantly with no network, using on-device speech for offline audio."}, {"id": "mobile_readme_auto_detect_mode", "label": "Auto-Detect Language Mode", "file_type": "concept", "source_file": "mobile/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null,